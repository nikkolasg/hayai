/-- [hayai_consensus_core::rule_sets::rules_at]:
    Source: 'crates/hayai-consensus-core/src/rule_sets.rs', lines 343:0-352:1
    Visibility: public -/
def rule_sets.rules_at
  (spec : chain_spec.CoreSpec) (height : Std.U32) :
  Result (core.result.Result rule_sets.RuleSet ConsensusError)
  := do
  let r ← chain_spec.CoreSpec.upgrade_at spec height
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let b ← chain_spec.CoreSpec.orchard_disabled spec height
    if b
    then
      let b1 ←
        core.cmp.PartialEq.ne.trait_default
          chain_spec.Upgrade.Insts.CoreCmpPartialEqUpgrade val
          chain_spec.Upgrade.Nu6_1
      if b1
      then ok (core.result.Result.Err ConsensusError.UncheckedSpec)
      else
        let rs ← rule_sets.NU6_1_ORCHARD_DISABLED
        ok (core.result.Result.Ok rs)
    else
      let a ← rule_sets.RULE_SETS
      let i ← chain_spec.Upgrade.index val
      let rs ← Array.index_usize a i
      ok (core.result.Result.Ok rs)
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
      rule_sets.RuleSet (core.convert.FromSame ConsensusError) residual

