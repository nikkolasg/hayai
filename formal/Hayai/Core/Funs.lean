/-- [hayai_consensus_core::subsidy_schedule::block_subsidy]:
    Source: 'crates/hayai-consensus-core/src/subsidy_schedule.rs', lines 67:0-76:1
    Visibility: public -/
def subsidy_schedule.block_subsidy
  (spec : chain_spec.CoreSpec) (height : Std.U32) :
  Result (core.result.Result subsidy_schedule.Subsidy ConsensusError)
  := do
  let r ← nsm.reissuance_active spec height
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    if val
    then
      ok (core.result.Result.Err (ConsensusError.IssuedSupplyUnknown height))
    else
      let r1 ← subsidy_schedule.scheduled_subsidy spec height
      let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
      match cf1 with
      | core.ops.control_flow.ControlFlow.Continue val1 =>
        let r2 ← funding.deferred_value spec height val1
        let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
        match cf2 with
        | core.ops.control_flow.ControlFlow.Continue val2 =>
          ok (core.result.Result.Ok { total := val1, deferred := val2 })
        | core.ops.control_flow.ControlFlow.Break residual =>
          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
            subsidy_schedule.Subsidy (core.convert.FromSame ConsensusError)
            residual
      | core.ops.control_flow.ControlFlow.Break residual =>
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          subsidy_schedule.Subsidy (core.convert.FromSame ConsensusError)
          residual
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
      subsidy_schedule.Subsidy (core.convert.FromSame ConsensusError) residual

