    {
      "type": "timeseries",
      "id": 11,
      "title": "Block validation time",
      "description": "sync_block_verify_duration_seconds{result=\"success\"}",
      "datasource": {
        "type": "prometheus",
        "uid": "hayai-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hayai-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sync_block_verify_duration_seconds_bucket{job=\"hayaid\", network=~\"$network\", result=\"success\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hayai-prometheus"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(sync_block_verify_duration_seconds_bucket{job=\"hayaid\", network=~\"$network\", result=\"success\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hayai-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sync_block_verify_duration_seconds_bucket{job=\"hayaid\", network=~\"$network\", result=\"success\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hayai-prometheus"
          },
          "expr": "sum(rate(sync_block_verify_duration_seconds_sum{job=\"hayaid\", network=~\"$network\", result=\"success\"}[$__rate_interval])) / sum(rate(sync_block_verify_duration_seconds_count{job=\"hayaid\", network=~\"$network\", result=\"success\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
