          },
          "expr": "race:machine_network_receive_bytes_per_second",
          "legendFormat": "{{node}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "race:machine_network_transmit_bytes_per_second",
          "legendFormat": "{{node}} out"
        }
