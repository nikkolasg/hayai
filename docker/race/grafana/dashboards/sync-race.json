      }
    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "Network",
      "description": "Bytes per second that the machine receives and sends (node-exporter).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
