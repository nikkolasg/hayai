# Variables of docker/compose.yml and docker/compose.observability.yml. Docker Compose
# reads this file from the docker/ directory. A variable set in the shell wins.

# testnet: zakurad and hayaid-testnet (shadow mode). mainnet: zakurad-mainnet and
# hayaid-mainnet (shadow mode). regtest: hayaid-regtest (full mode).
COMPOSE_PROFILES=testnet

# Host address of the admin ports: hayaid RPC and metrics, Zakura metrics, Prometheus,
# Grafana, Alertmanager. 127.0.0.1 keeps them local (use an SSH or SSM port forward).
# 0.0.0.0 opens them; then a firewall must restrict them (deploy/terraform/aws does).
HAYAI_ADMIN_BIND=127.0.0.1

# The hayaid image that compose builds (docker/Dockerfile) and the crypto backend of the
# build: upstream or zakura.
HAYAI_IMAGE=hayaid:local
HAYAI_CRYPTO_BACKEND=upstream

# The Zakura image of the testnet and mainnet profiles, built from a Zakura checkout.
ZAKURA_IMAGE=zakurad:local
