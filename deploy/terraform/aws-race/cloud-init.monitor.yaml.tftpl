#cloud-config
# Rendered by main.tf for machine C. First boot: install Docker, clone the race files and
# start Prometheus and Grafana with docker/race/compose.monitor.yml.

package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - git

write_files:
  - path: /usr/local/sbin/race-monitor
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      install -d -m 0755 /opt/race
      if [ ! -d /opt/race/hayai/.git ]; then
        git clone '${hayai_repo}' /opt/race/hayai
      fi
      git -C /opt/race/hayai checkout --detach '${hayai_ref}'
      cd /opt/race/hayai/docker/race
      # Grafana on all interfaces: the security group limits port 3000 to admin_cidr.
      printf '%s\n' 'RACE_NETWORK=${network}' \
        'RACE_ZAKURAD_HOST=${zakurad_host}' 'RACE_HAYAID_HOST=${hayaid_host}' \
        'RACE_GRAFANA_ADDR=0.0.0.0' >.env
      # Grafana admin password, generated once. The directory keeps it private. The file
      # stays readable: Compose mounts it with its mode, and Grafana runs as uid 472.
      install -d -m 0700 secrets
      if [ ! -f secrets/grafana_admin_password ]; then
        (umask 022 && head -c 18 /dev/urandom | base64 >secrets/grafana_admin_password)
      fi
      docker compose -f compose.monitor.yml up -d

  - path: /etc/systemd/system/race-monitor.service
    permissions: "0644"
    content: |
      [Unit]
      Description=sync race monitoring (Prometheus and Grafana)
      After=network-online.target docker.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/race-monitor
      TimeoutStartSec=infinity

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, --no-block, race-monitor.service]
